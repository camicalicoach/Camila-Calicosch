{
  "title": "Estudio de reels",
  "sample": "Hola",
  "presets": [
    {
      "label": "Pop",
      "hint": "Cal Sans amarillo, destacados de color que rebotan",
      "captions": {
        "style": "pop"
      }
    },
    {
      "label": "Clean",
      "hint": "Blanco, una palabra, destacado en itálica amarilla",
      "captions": {
        "style": "clean"
      }
    },
    {
      "label": "Bold",
      "hint": "Montserrat Black en mayúscula",
      "captions": {
        "style": "clean",
        "font": "montserrat",
        "emphFont": "montserrat",
        "case": "upper",
        "emphItalic": false,
        "shadow": "soft"
      }
    },
    {
      "label": "Impacto",
      "hint": "Anton alto y angosto, blanco y amarillo",
      "captions": {
        "style": "pop",
        "font": "anton",
        "emphFont": "anton",
        "case": "upper",
        "color": "#FFFFFF",
        "emphColor": "#FFE14D",
        "shadow": "strong"
      }
    },
    {
      "label": "Editorial",
      "hint": "Inter limpio con destacados en serif itálica",
      "captions": {
        "style": "clean",
        "emphFont": "dmserif",
        "emphCase": "asis",
        "emphItalic": true
      }
    },
    {
      "label": "Caja",
      "hint": "Poppins sobre una caja oscura, se lee en cualquier fondo",
      "captions": {
        "style": "clean",
        "font": "poppins",
        "emphFont": "poppins",
        "shadow": "box",
        "emphItalic": false
      }
    },
    {
      "label": "Arco",
      "hint": "Minúscula amarilla pálida en arco sobre la cabeza; el remate en serif itálica",
      "captions": {
        "style": "clean",
        "font": "montserrat-m",
        "emphFont": "dmserif",
        "color": "#F6EB8F",
        "emphColor": "#F6EB8F",
        "case": "lower",
        "emphCase": "upper",
        "emphItalic": true,
        "shadow": "light",
        "anim": "soft",
        "size": 86,
        "emphSize": 132,
        "y": 430,
        "curve": 210,
        "tilt": 6
      }
    },
    {
      "label": "Arco blanco",
      "hint": "Igual de curvo pero chiquito y blanco, más discreto",
      "captions": {
        "style": "clean",
        "font": "montserrat-m",
        "emphFont": "montserrat-m",
        "color": "#FFFFFF",
        "emphColor": "#F6EB8F",
        "case": "lower",
        "emphCase": "lower",
        "emphItalic": false,
        "shadow": "light",
        "anim": "soft",
        "size": 54,
        "emphSize": 84,
        "y": 430,
        "curve": 170,
        "tilt": 8
      }
    },
    {
      "label": "Cine",
      "hint": "Una palabra crema con sombra a media altura y color de cine (verde salvia, piel dorada, grano)",
      "captions": {
        "style": "clean",
        "font": "inter",
        "emphFont": "inter",
        "color": "#F3DCA7",
        "emphColor": "#F3DCA7",
        "case": "lower",
        "emphCase": "lower",
        "emphItalic": false,
        "shadow": "soft",
        "anim": "soft",
        "size": 112,
        "emphSize": 132,
        "y": 1120
      },
      "set": {
        "grade": "cine"
      }
    },
    {
      "label": "Girly",
      "hint": "Blanco bold arriba de la cabeza, destacado rosa bebé con brillitos y un sticker que aparece",
      "captions": {
        "style": "clean",
        "font": "montserrat-b",
        "emphFont": "montserrat-b",
        "color": "#FFFFFF",
        "emphColor": "#F9B4D0",
        "case": "asis",
        "emphCase": "asis",
        "emphItalic": false,
        "shadow": "light",
        "anim": "soft",
        "size": 62,
        "emphSize": 92,
        "y": 420,
        "sparkles": true,
        "emphStickers": "girly"
      }
    },
    {
      "label": "Girly serif",
      "hint": "Igual, con el destacado en serif itálica amarilla pálida",
      "captions": {
        "style": "clean",
        "font": "montserrat-b",
        "emphFont": "dmserif",
        "color": "#FFFFFF",
        "emphColor": "#F8EDA8",
        "case": "asis",
        "emphCase": "asis",
        "emphItalic": true,
        "shadow": "light",
        "anim": "soft",
        "size": 62,
        "emphSize": 100,
        "y": 420,
        "sparkles": true,
        "emphStickers": "girly"
      }
    }
  ],
  "presetKeys": [
    "style",
    "font",
    "emphFont",
    "color",
    "emphColor",
    "case",
    "emphCase",
    "emphItalic",
    "shadow",
    "anim",
    "emphSfx",
    "size",
    "emphSize",
    "y",
    "curve",
    "tilt",
    "emphBox",
    "sparkles",
    "emphStickers"
  ],
  "groups": [
    {
      "label": "Color de la imagen",
      "controls": [
        {
          "key": "grade",
          "label": "Look",
          "type": "segment",
          "choices": [
            {
              "v": null,
              "label": "Natural"
            },
            {
              "v": "cine",
              "label": "Cine",
              "dot": "#7E9C86"
            },
            {
              "v": "calido",
              "label": "Cálido",
              "dot": "#E2A35C"
            },
            {
              "v": "film",
              "label": "Film lavado",
              "dot": "#B9B3A0"
            },
            {
              "v": "frio",
              "label": "Frío",
              "dot": "#6F8FB0"
            }
          ],
          "hint": "En la vista previa tarda unos segundos la primera vez; en el render se aplica sobre el 4K"
        },
        {
          "key": "gradeAmount",
          "label": "Intensidad",
          "type": "range",
          "min": 0.2,
          "max": 1.5,
          "step": 0.1,
          "unit": "×"
        }
      ]
    },
    {
      "label": "Tipografía",
      "controls": [
        {
          "key": "captions.font",
          "label": "Subtítulos",
          "type": "font",
          "choices": "fonts"
        },
        {
          "key": "captions.emphFont",
          "label": "Destacados",
          "type": "font",
          "choices": "fonts"
        },
        {
          "key": "titleFont",
          "label": "Títulos detrás de la cabeza",
          "type": "font",
          "choices": "fonts"
        }
      ]
    },
    {
      "label": "Color",
      "controls": [
        {
          "key": "captions.color",
          "label": "Subtítulos",
          "type": "color",
          "choices": [
            "#FFFFFF",
            "#FFD60A",
            "#FFE14D",
            "#F6EB8F",
            "#F5F0E6",
            "#F3DCA7"
          ]
        },
        {
          "key": "captions.emphColor",
          "label": "Destacados",
          "type": "color",
          "choices": [
            null,
            "#E2577F",
            "#E07A4F",
            "#9B7FD8",
            "#E8B53E",
            "#7FA86A",
            "#FFE14D",
            "#F6EB8F",
            "#F9B4D0",
            "#F8EDA8",
            "#F3DCA7",
            "#BBCDF3",
            "#FAE271",
            "#ACD56B",
            "#2A5B98",
            "#FFFFFF"
          ],
          "nullLabel": "Un color por destacado (rota la paleta)"
        }
      ]
    },
    {
      "label": "Texto",
      "controls": [
        {
          "key": "captions.case",
          "label": "Mayúsculas",
          "type": "segment",
          "choices": [
            {
              "v": "asis",
              "label": "Como se dijo"
            },
            {
              "v": "auto",
              "label": "minúscula al empezar"
            },
            {
              "v": "upper",
              "label": "MAYÚSCULA"
            },
            {
              "v": "lower",
              "label": "minúscula"
            }
          ]
        },
        {
          "key": "captions.emphCase",
          "label": "Destacados",
          "type": "segment",
          "choices": [
            {
              "v": "upper",
              "label": "MAYÚSCULA"
            },
            {
              "v": "asis",
              "label": "Como se dijo"
            }
          ]
        },
        {
          "key": "captions.emphItalic",
          "label": "Destacados en itálica",
          "type": "toggle"
        },
        {
          "key": "captions.shadow",
          "label": "Para que se lea",
          "type": "segment",
          "choices": [
            {
              "v": "light",
              "label": "Sombra suave"
            },
            {
              "v": "soft",
              "label": "Sombra"
            },
            {
              "v": "strong",
              "label": "Sombra fuerte"
            },
            {
              "v": "box",
              "label": "Caja"
            },
            {
              "v": "none",
              "label": "Nada"
            }
          ]
        },
        {
          "key": "captions.emphBox",
          "label": "Destacados sobre",
          "type": "segment",
          "choices": [
            {
              "v": null,
              "label": "Nada"
            },
            {
              "v": "pill",
              "label": "Píldora de color"
            }
          ]
        },
        {
          "key": "captions.sparkles",
          "label": "Brillitos ✦ en los destacados",
          "type": "toggle"
        },
        {
          "key": "captions.emphStickers",
          "label": "Sticker en cada destacado",
          "type": "segment",
          "choices": [
            {
              "v": null,
              "label": "Ninguno"
            },
            {
              "v": "girly",
              "label": "Pack girly (estrellas, corazones, brillos)"
            }
          ],
          "hint": "Los packs viven en ~/reel-stickers (scripts/stickers.py cut)"
        }
      ]
    },
    {
      "label": "Tamaño y lugar",
      "controls": [
        {
          "key": "captions.size",
          "label": "Subtítulos",
          "type": "range",
          "min": 56,
          "max": 130,
          "step": 2,
          "unit": "px"
        },
        {
          "key": "captions.emphSize",
          "label": "Destacados",
          "type": "range",
          "min": 90,
          "max": 200,
          "step": 2,
          "unit": "px"
        },
        {
          "key": "captions.y",
          "label": "Altura",
          "type": "range",
          "min": 260,
          "max": 1400,
          "step": 10,
          "unit": "px",
          "hint": "Arriba de la cabeza (300-500) para el arco; a la altura del pecho (1150-1300) para el resto"
        },
        {
          "key": "captions.curve",
          "label": "Curva (arco)",
          "type": "range",
          "min": 0,
          "max": 300,
          "step": 10,
          "unit": "px",
          "hint": "0 = recto. Con curva el subtítulo se dobla como un halo"
        },
        {
          "key": "captions.tilt",
          "label": "Inclinación",
          "type": "range",
          "min": 0,
          "max": 12,
          "step": 1,
          "unit": "°"
        }
      ]
    },
    {
      "label": "Movimiento y sonido",
      "controls": [
        {
          "key": "captions.anim",
          "label": "Entrada de las palabras",
          "type": "segment",
          "choices": [
            {
              "v": "pop",
              "label": "Pop con rebote"
            },
            {
              "v": "soft",
              "label": "Suave"
            },
            {
              "v": "none",
              "label": "Sin animación"
            }
          ]
        },
        {
          "key": "autoZoom",
          "label": "Zoom de cámara en cada destacado",
          "type": "toggle"
        },
        {
          "key": "captions.emphSfx",
          "label": "Sonido en los destacados",
          "type": "segment",
          "choices": [
            {
              "v": "pop",
              "label": "Pop"
            },
            {
              "v": "click",
              "label": "Click"
            },
            {
              "v": "ding",
              "label": "Ding"
            },
            {
              "v": null,
              "label": "Ninguno"
            }
          ]
        },
        {
          "key": "sfx.gain",
          "label": "Volumen de los efectos",
          "type": "range",
          "min": 0,
          "max": 1.5,
          "step": 0.1,
          "unit": "×"
        }
      ]
    }
  ],
  "fonts": [
    {
      "v": "cal",
      "label": "Cal Sans",
      "family": "Cal Sans",
      "weight": 400,
      "src": "assets/fonts/CalSans-Regular.ttf"
    },
    {
      "v": "inter",
      "label": "Inter",
      "family": "Inter",
      "weight": 800,
      "src": "assets/fonts/Inter-ExtraBold.ttf"
    },
    {
      "v": "montserrat",
