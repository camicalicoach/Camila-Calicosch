      "src": "assets/fonts/BebasNeue-Regular.ttf"
    },
    {
      "v": "dmserif",
      "label": "DM Serif",
      "family": "DM Serif Display",
      "weight": 400,
      "src": "assets/fonts/DMSerifDisplay-Regular.ttf"
    },
    {
      "v": "caveat",
      "label": "Caveat (a mano)",
      "family": "Caveat",
      "weight": 700,
      "src": "assets/fonts/Caveat-Bold.ttf"
    },
    {
      "v": "bootzy",
      "label": "Bootzy",
      "family": "Bootzy",
      "weight": 400,
      "src": "assets/local-fonts/BootzyTM.ttf"
    }
  ]
}
