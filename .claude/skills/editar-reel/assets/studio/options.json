      "src": "assets/fonts/Montserrat-Variable.ttf"
    },
    {
      "v": "montserrat-m",
      "label": "Montserrat Medium",
      "family": "Montserrat",
      "weight": 500,
      "src": "assets/fonts/Montserrat-Variable.ttf"
    },
    {
      "v": "montserrat-b",
      "label": "Montserrat Bold",
      "family": "Montserrat",
      "weight": 700,
      "src": "assets/fonts/Montserrat-Variable.ttf"
    },
    {
      "v": "poppins",
      "label": "Poppins",
      "family": "Poppins",
      "weight": 800,
      "src": "assets/fonts/Poppins-ExtraBold.ttf"
    },
    {
      "v": "grotesk",
      "label": "Space Grotesk",
